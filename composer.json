{
    "name": "itk-dev/kimai-plugin-aarhuskommune",
    "description": "A Kimai plugin for Aarhus Kommune",
    "license": "MIT",
    "type": "kimai-plugin",
    "keywords": [
        "kimai",
        "kimai-plugin"
    ],
    "authors": [
        {
            "name": "Mikkel Ricky",
            "homepage": "https://github.com/rimi-itk"
        }
    ],
    "homepage": "https://github.com/itk-dev/kimai-plugin-AarhusKommuneBundle",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.43",
        "friendsofphp/php-cs-fixer": "^3.0",
        "kimai/kimai": "dev-main",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/console": "^6.0",
        "symfony/event-dispatcher": "^6.0",
        "vincentlanglet/twig-cs-fixer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "KimaiPlugin\\AarhusKommuneBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KimaiPlugin\\AarhusKommuneBundle\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "audit": {
            "abandoned": "report"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "kimai": {
            "name": "Aarhus kommune",
            "require": 26100
        }
    }
}
